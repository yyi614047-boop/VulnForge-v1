# Copy this file to .env and fill in your credentials.
# .env is ignored by Git.

# LLM credentials. Use VULNFORGE_MODEL_API_KEY or OPENAI_API_KEY.
VULNFORGE_MODEL_API_KEY=
OPENAI_API_KEY=

# Metasploit RPC credentials.
MSFRPC_USER=
MSFRPC_PASS=

# Optional runtime settings.
VULNFORGE_MODEL=
VULNFORGE_MODEL_BASE_URL=
VULNFORGE_MODEL_TIMEOUT=180
VULNFORGE_MODEL_MAX_RETRIES=1
VULNFORGE_VULHUB_ROOT=
MSF_CONTAINER_NAME=vulnforge-metasploit
MSFRPC_TRANSPORT=docker-exec
MSFRPC_HOST=127.0.0.1
MSFRPC_PORT=55553
MSFRPC_CONTAINER_PORT=55553
MSFRPC_TIMEOUT=60
